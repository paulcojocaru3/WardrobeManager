# Build artifacts (.NET) - never ship Windows obj/bin into a Linux image
**/bin/
**/obj/
**/.vs/
**/*.user

# Frontend & Python (built inside their own images)
wardrobe_web/node_modules/
wardrobe_web/dist/
ml_api/__pycache__/
**/*.pyc
ml_api/fashion_my_model.h5
ml_api/eval/

# Local secrets & data - never copy into the image
.env
**/.env
*.dump
eval/
screenshots/
wardrobe_web/design-demos/

# VCS & misc
.git/
.gitignore
**/.dockerignore
docker-compose*.yml
README.md
*.md
